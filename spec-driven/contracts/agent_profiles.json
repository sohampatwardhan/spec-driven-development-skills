{
  "schema_version": 1,
  "agents": {
    "claude": {
      "binary": "claude",
      "unattended_flags": ["--permission-mode", "auto"],
      "model_flag": "--model",
      "effort_flag": "--effort",
      "effort_map": {"extra_high": "xhigh"},
      "role_overrides": {
        "implementer": {
          "unattended_flags": ["--permission-mode", "auto"]
        },
        "reviewer": {
          "unattended_flags": ["--permission-mode", "plan", "--tools", "Read,Grep,Glob"]
        },
        "explorer": {
          "unattended_flags": ["--permission-mode", "plan", "--tools", "Read,Grep,Glob"]
        }
      }
    },
    "codex": {
      "binary": "codex",
      "unattended_flags": ["--approve-for-me"],
      "model_flag": "--model",
      "effort_flag": "-c model_reasoning_effort=",
      "effort_map": {"extra_high": "xhigh"},
      "role_overrides": {
        "implementer": {
          "unattended_flags": ["--approve-for-me"]
        },
        "reviewer": {
          "unattended_flags": ["--sandbox", "read-only", "--ask-for-approval", "never"]
        },
        "explorer": {
          "unattended_flags": ["--sandbox", "read-only", "--ask-for-approval", "never"]
        }
      }
    },
    "agy": {
      "binary": "agy",
      "unattended_flags": ["--dangerously-skip-permissions"],
      "model_flag": "--model",
      "effort_flag": "--effort",
      "effort_map": {"extra_high": "high"},
      "role_overrides": {
        "implementer": {
          "unattended_flags": ["--dangerously-skip-permissions"]
        },
        "reviewer": {
          "unattended_flags": ["--mode", "plan", "--sandbox"]
        },
        "explorer": {
          "unattended_flags": ["--mode", "plan", "--sandbox"]
        }
      }
    },
    "cursor": {
      "binary": "cursor-agent",
      "unattended_flags": ["--approve-all", "--headless"],
      "model_flag": "--model",
      "effort_flag": "--thinking-level",
      "role_overrides": {
        "implementer": {
          "unattended_flags": ["--approve-all", "--headless"]
        },
        "reviewer": {
          "unattended_flags": ["--headless", "--read-only"]
        }
      }
    },
    "opencode": {
      "binary": "opencode",
      "unattended_flags": ["--auto-confirm", "--yes"],
      "model_flag": "--model",
      "effort_flag": "--reasoning",
      "role_overrides": {
        "implementer": {
          "unattended_flags": ["--auto-confirm", "--yes"]
        },
        "reviewer": {
          "unattended_flags": ["--read-only"]
        }
      }
    }
  }
}
