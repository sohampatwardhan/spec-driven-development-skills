{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.agentskills.io/schemas/05_execution.schema.json",
  "title": "SpecExecutionSidecar",
  "description": "Schema for 05_execution.json execution ledger, timing intervals, Gantt IR, and Orca telemetry sidecar",
  "type": "object",
  "required": ["schema_version", "generated_from", "runs", "task_attempts", "gantt"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "generated_from": {
      "type": "object",
      "required": ["file", "sha256"],
      "properties": {
        "file": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "started_utc", "stopped_utc", "elapsed_seconds", "outcome"],
        "properties": {
          "run_id": { "type": "string" },
          "orca_run_id": { "type": "string" },
          "started_utc": { "type": "string" },
          "stopped_utc": { "type": "string" },
          "elapsed_seconds": { "type": ["integer", "string"] },
          "outcome": { "type": "string" }
        }
      }
    },
    "task_attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "stage_wave", "task", "attempt", "started_utc", "stopped_utc", "elapsed_seconds", "outcome"],
        "properties": {
          "run_id": { "type": "string" },
          "stage_wave": { "type": "string" },
          "task": { "type": "string" },
          "attempt": { "type": "integer" },
          "orca_dispatch_id": { "type": "string" },
          "started_utc": { "type": "string" },
          "stopped_utc": { "type": "string" },
          "elapsed_seconds": { "type": ["integer", "string"] },
          "outcome": { "type": "string" }
        }
      }
    },
    "task_status": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "state", "blockers"],
        "properties": {
          "task_id": { "type": "string" },
          "state": { "type": "string", "enum": ["blocked", "ready", "running", "failed", "done"] },
          "attempt": { "type": ["integer", "null"] },
          "updated_utc": { "type": ["string", "null"] },
          "blockers": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "checkpoint_commits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["wave", "commit", "verified"],
        "properties": {
          "wave": { "type": "integer" },
          "commit": { "type": "string" },
          "verified": { "type": "boolean" },
          "evidence": { "type": "string" }
        }
      }
    },
    "gantt": {
      "type": "object",
      "required": ["diagram", "target", "sections"],
      "properties": {
        "diagram": { "type": "string" },
        "target": { "type": "string" },
        "dateFormat": { "type": "string" },
        "axisFormat": { "type": "string" },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "bars"],
            "properties": {
              "name": { "type": "string" },
              "bars": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "label", "start", "end"],
                  "properties": {
                    "id": { "type": "string" },
                    "label": { "type": "string" },
                    "start": { "type": "string" },
                    "end": { "type": "string" },
                    "tags": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
